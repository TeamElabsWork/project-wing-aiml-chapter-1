# Environment Configuration Example
# Copy to .env for local overrides if needed.

# Application Environment
ORCHESTRATOR_ENV=development
LOG_LEVEL=INFO

# Database (Postgres + pgvector - Optional, in-memory used by default)
POSTGRES_DB=orchestrator_db
POSTGRES_USER=orchestrator_user
POSTGRES_PASSWORD=orchestrator_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://orchestrator_user:orchestrator_password@localhost:5432/orchestrator_db

# LLM Providers (Unset placeholders - do NOT put real keys in repo)
LLM_PROVIDER=mock
ROUTER_MODEL=unset
EXECUTOR_MODEL=unset
